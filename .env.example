# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Development Auth Bypass
# Set to 'true' to skip authentication in development (useful for MCP browser access)
VITE_SKIP_AUTH=false

VITE_CIVITAI_API_KEY=your-civitai-api-key-here

# Fal.ai for AI image generation
# Get from: https://fal.ai/dashboard/keys
VITE_FAL_AI_KEY=your-fal-ai-key-here

# OpenRouter for vision-capable Story AI chat
# Get from: https://openrouter.ai/keys
VITE_OPENROUTER_KEY=your-openrouter-key-here