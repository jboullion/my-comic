# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Development Auth Bypass
# Set to 'true' to skip authentication in development (useful for MCP browser access)
VITE_SKIP_AUTH=false

# Image generation credentials belong in Supabase Edge Function secrets, never VITE_*.
# Required server secret: FAL_AI_KEY (https://fal.ai/dashboard/keys)
# Optional server secret for gated Civitai downloads: CIVITAI_API_KEY
# Public Civitai downloads work without a Civitai key.

# OpenRouter for vision-capable Story AI chat
# Get from: https://openrouter.ai/keys
VITE_OPENROUTER_KEY=your-openrouter-key-here
